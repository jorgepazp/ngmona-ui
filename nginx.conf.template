server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_vary on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Angular's outputHashing:"all" puts a content hash in every build asset's filename, so these
    # are safe to cache forever — a new deploy ships under new filenames, never overwrites these.
    location ~* \.(?:js|css|woff2?|ttf|svg|png|jpg|jpeg|gif|ico)$ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # index.html itself must always be revalidated — it's what points at the (hashed) current
    # build, so caching it would pin visitors to an old deploy.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}

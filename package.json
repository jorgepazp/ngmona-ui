{
  "name": "ui-kit-showcase",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:cli": "npm test -w ngmona-ui",
    "test:prefix-smoke": "node scripts/prefix-smoke.mjs",
    "api-docs": "node scripts/generate-api-docs.mjs",
    "theme:generate": "node scripts/generate-theme.mjs",
    "registry:build": "node packages/cli/scripts/build-registry.mjs",
    "generate": "npm run api-docs && npm run registry:build"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@angular/cdk": "^22.1.2",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@lucide/angular": "^1.31.0",
    "prismjs": "^1.30.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.0",
    "@ngmona-ui/color": "*",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/prismjs": "^1.26.6",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
